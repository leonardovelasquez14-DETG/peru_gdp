% Paquete compartido para manuales tecnicos y teoricos en formato APA 7 (espanol)
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{apa_manual}[2026/11/17 Formato APA 7 para manuales del proyecto PBI Peru]

\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage[spanish,es-tabla,es-noitemize,es-noenumerate,es-ucroman,es-noshorthands]{babel}
\RequirePackage{tgtermes}
\RequirePackage[scaled=0.88]{beramono}
\RequirePackage{amsmath,amssymb}
\RequirePackage{geometry}
\geometry{letterpaper, margin=1in, headheight=15pt}

\RequirePackage{setspace}
\doublespacing

\RequirePackage{indentfirst}
\setlength{\parindent}{0.5in}
\setlength{\parskip}{0pt}

\RequirePackage{microtype}
\RequirePackage{xcolor}
\definecolor{apaNavy}{HTML}{1B365D}
\definecolor{apaAccent}{HTML}{C84B31}
\definecolor{apaGreen}{HTML}{2E8B57}
\definecolor{apaSlate}{HTML}{5C6773}
\definecolor{apaBg}{HTML}{F7F8FA}
\definecolor{apaBorder}{HTML}{D0D7DE}

\RequirePackage{fancyhdr}
\newcommand{\@aparunninghead}{MANUAL DEL PROYECTO PBI PERU}
\newcommand{\apatituloCorto}[1]{\renewcommand{\@aparunninghead}{\MakeUppercase{#1}}}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\color{apaSlate}\@aparunninghead}
\fancyhead[R]{\small\thepage}
\renewcommand{\headrulewidth}{0pt}
\fancypagestyle{plain}{%
  \fancyhf{}
  \fancyhead[L]{\small\color{apaSlate}\@aparunninghead}
  \fancyhead[R]{\small\thepage}
  \renewcommand{\headrulewidth}{0pt}
}

% Jerarquia de titulos APA 7 (Niveles 1, 2 y 3 sin numeracion invasiva)
\RequirePackage{titlesec}
\setcounter{secnumdepth}{0}
\titleformat{\section}{\centering\normalfont\bfseries\normalsize}{}{0pt}{}
\titlespacing*{\section}{0pt}{14pt}{6pt}

\titleformat{\subsection}{\raggedright\normalfont\bfseries\normalsize}{}{0pt}{}
\titlespacing*{\subsection}{0pt}{12pt}{4pt}

\titleformat{\subsubsection}{\raggedright\normalfont\bfseries\itshape\normalsize}{}{0pt}{}
\titlespacing*{\subsubsection}{0pt}{10pt}{2pt}

% Tablas y figuras estilo APA 7: numero en negrita arriba, titulo en cursiva debajo
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{caption}
\DeclareCaptionLabelFormat{apabold}{\textbf{#1 #2}}
\DeclareCaptionTextFormat{apaitalic}{\textit{#1}}
\captionsetup{
  labelformat=apabold,
  textformat=apaitalic,
  labelsep=newline,
  justification=raggedright,
  singlelinecheck=false,
  position=top,
  skip=4pt,
  font={singlespacing}
}

\RequirePackage{siunitx}
\sisetup{
  output-decimal-marker={,},
  detect-all
}

\RequirePackage{etoolbox}
\AtBeginEnvironment{tabular}{\singlespacing\small}
\AtBeginEnvironment{table}{\singlespacing}
\AtBeginEnvironment{figure}{\singlespacing}

% Nota explicativa APA debajo de tablas o figuras
\newcommand{\apanota}[1]{%
  \vspace{4pt}%
  \begin{flushleft}
    \singlespacing\small\noindent\textit{Nota.} #1%
  \end{flushleft}
}

% Recuadro didactico de proposito/ejemplo sin romper interlineado
\newcommand{\cajaproposito}[2]{%
  \vspace{6pt}%
  \noindent\fcolorbox{apaBorder}{apaBg}{%
    \parbox{\dimexpr\textwidth-2\fboxsep-2\fboxrule\relax}{%
      \singlespacing\small\setlength{\parindent}{0pt}%
      \textbf{\color{apaNavy}#1}\par\vspace{3pt}#2%
    }%
  }\vspace{8pt}\par%
}

% Cabecera APA de inicio de documento
\newcommand{\apacabecera}[3]{%
  \begin{center}
    \singlespacing
    \textbf{\large #1}\par
    \vspace{4pt}
    {\normalsize #2}\par
    \vspace{2pt}
    {\small\color{apaSlate} Proyecto: Predicci\'on en tiempo real de revisiones del PBI del Per\'u --- Material te\'orico y gu\'ia pr\'actica}\par
  \end{center}
  \vspace{8pt}
  \cajaproposito{Para qu\'e sirve este documento en nuestro trabajo}{#3}
}

% Codigo inline seguro para guiones bajos y rutas largas
\RequirePackage{xurl}
\newcommand{\codigo}[1]{\texttt{\nolinkurl{#1}}}

% Bloques de codigo Python / Bash con soporte UTF-8
\RequirePackage{listings}
\renewcommand{\lstlistingname}{C\'odigo}
\lstset{
  basicstyle=\ttfamily\footnotesize\singlespacing,
  backgroundcolor=\color{apaBg},
  frame=leftline,
  rulecolor=\color{apaNavy},
  framesep=6pt,
  xleftmargin=12pt,
  xrightmargin=4pt,
  breaklines=true,
  showstringspaces=false,
  keywordstyle=\bfseries\color{apaNavy},
  commentstyle=\itshape\color{apaSlate},
  stringstyle=\color{apaAccent},
  literate=
    {á}{{\'a}}1 {é}{{\'e}}1 {í}{{\'i}}1 {ó}{{\'o}}1 {ú}{{\'u}}1
    {Á}{{\'A}}1 {É}{{\'E}}1 {Í}{{\'I}}1 {Ó}{{\'O}}1 {Ú}{{\'U}}1
    {ñ}{{\~n}}1 {Ñ}{{\~N}}1 {ü}{{\"u}}1 {¿}{{?`}}1 {¡}{{!`}}1
}
\AtBeginEnvironment{lstlisting}{\singlespacing}

% Graficos vectoriales y diagramas
\RequirePackage{tikz}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\usetikzlibrary{arrows.meta,positioning,shapes.geometric,calc,fit,backgrounds,matrix,babel}

% Bibliografia APA 7 con Biber
\RequirePackage[autostyle=true,spanish=spanish]{csquotes}
\RequirePackage[backend=biber,style=apa,sortcites=true,sorting=nyt]{biblatex}
\addbibresource{referencias_teoria.bib}

% Referencias APA al final
\newcommand{\apabibliografia}{%
  \section{Referencias}
  \begingroup
    \singlespacing
    \setlength{\parindent}{0pt}
    \printbibliography[heading=none]
  \endgroup
}

\RequirePackage[hidelinks]{hyperref}
